{
  "name": "@somni/chat-react",
  "version": "1.0.0",
  "description": "React hooks for Somni Chat Engine",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@somni/chat-core": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "@somni/chat-call": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@somni/chat-call": {
      "optional": true
    }
  },
  "devDependencies": {
    "@somni/chat-call": "^1.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mazenmohemed123-ship-it/somni-chat.git",
    "directory": "packages/chat-react"
  }
}
