{
  "name": "@somni/adapter-firebase",
  "version": "0.1.0",
  "description": "Firebase/Firestore adapter for Somni Chat Engine",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@somni/chat-core": "workspace:*"
  },
  "peerDependencies": {
    "firebase": "^10.0.0"
  },
  "devDependencies": {
    "firebase": "^10.12.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "sideEffects": false
}
